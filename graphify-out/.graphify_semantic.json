    {
      "id": "concept_rainmeter_k_formula",
      "label": "Rainmeter Temporal Smoothing Formula",
      "file_type": "rationale",
      "source_file": "src/visualizer/processor.rs",
      "source_location": "31-36",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Uses Rainmeter's exact k-constant calculation: k = 0.01 ^ (1 / (FPS * TimeInSeconds)) for temporal attack, decay, and alpha parameters to replicate native visualizer physics cleanly."
    },
    {
      "id": "concept_monstercat_spatial_smoothing",
      "label": "Monstercat Spatial Smoothing",
      "file_type": "rationale",
      "source_file": "src/visualizer/smoothing.rs",
      "source_location": "60-156",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Replicates the spatial tapers and divisor coefficients of the Monstercat Rainmeter skin, dynamically scaling the inner 9 bars on the left and right edges depending on visualizer resolution."
    },
    {
      "id": "concept_smart_pause",
      "label": "Smart Pause/Wake Visualizer Stream",
      "file_type": "rationale",
      "source_file": "src/visualizer/mod.rs",
      "source_location": "101-116",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Optimizes visualizer thread resource utilization by monitoring connected browser clients and active track states, pausing raw audio capturing loops during silence or idle periods to conserve CPU."
    },
    {
      "id": "concept_track_formatting_regex",
      "label": "Discord Activity Metadata Scrubbing",
      "file_type": "rationale",
      "source_file": "typescript/handlers/rpc.ts",
      "source_location": "143-169",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Performs deep metadata scrub of song titles to remove redundant artist suffixes, video brackets (e.g. '[Official Music Video]'), and licensing tags to keep Discord RPC display elegant."
    },
